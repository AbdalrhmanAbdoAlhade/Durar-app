{
	"info": {
		"name": "Durar Store API",
		"description": "متجر الحلي والأحجار الكريمة — Laravel API (Sanctum + Spatie Permission + EdfaPay + FCM).\n\nطريقة الاستخدام:\n1. عدّل variable باسم base_url حسب سيرفرك (مثال: http://localhost:8000/api).\n2. نفّذ Auth > Register أو Login — التوكن بيتحفظ تلقائيًا في customer_token.\n3. سجّل دخول بحساب أدمن (role = admin) — التوكن بيتحفظ في admin_token.\n4. كل الردود الناجحة شكلها: { success: true, message, data } والأخطاء: { success: false, message }.\n5. طلبات الرفع (multipart) ابعتها ك form-data واختار ملف الصورة من جهازك.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "customer_token",
			"value": ""
		},
		{
			"key": "admin_token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"description": "التسجيل والدخول وإدارة الجلسة.",
			"item": [
				{
					"name": "Register",
					"description": "إنشاء حساب جديد وإصدار توكن Sanctum. شرط: password_confirmation يطابق password. الرد 201 وفيه data.user و data.token (بيتحفظ تلقائيًا في customer_token). خطأ 422 لو الإيميل مكرر أو البيانات ناقصة.",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) { pm.collectionVariables.set('customer_token', json.data.token); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Ahmed\",\n    \"email\": \"ahmed@example.com\",\n    \"phone\": \"01000000000\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					}
				},
				{
					"name": "Login",
					"description": "تسجيل الدخول بالإيميل والباسورد. الرد 200 وفيه data.token (بيتحفظ تلقائيًا في customer_token). خطأ 401 لو البيانات غلط، و422 لو ناقصة.",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) { pm.collectionVariables.set('customer_token', json.data.token); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"ahmed@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					}
				},
				{
					"name": "Admin Login",
					"description": "تسجيل دخول حساب الأدمن (لازم يكون واخد role باسم admin). التوكن بيتحفظ في admin_token وبيستخدم في فولدر Admin. انسخ نفس body الـ Login بإيميل الأدمن.",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) { pm.collectionVariables.set('admin_token', json.data.token); }"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					}
				},
				{
					"name": "Me",
					"description": "بيانات المستخدم الحالي (محتاج Bearer token). الرد 200 وفيه data.id و data.roles. خطأ 401 من غير توكن.",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customer_token}}",
									"type": "string"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Logout",
					"description": "مسح توكن الجلسة الحالية (محتاج Bearer token). الرد 200. خطأ 401 من غير توكن.",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{customer_token}}",
									"type": "string"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout"]
						}
					}
				}
			]
		},
